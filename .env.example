# AI Quant Platform — environment variables
# Copy:  cp .env.example .env   (aur .env ko kabhi git mein mat daalo — secrets!)

# ---------- AI Agent (Phase 2) ----------
# Real LLM ke liye (optional — default mock LLM free hai)
# pip install litellm  (ya: pip install .[llm])
# LLM_MODEL="gemini/gemini-2.0-flash"
# LLM_API_KEY="your-key"

# ---------- Live Trading (Phase 4) — ⚠️ REAL MONEY ----------
# Default: sab DISABLED. Enable sirf tab jab SAFETY.md padh chuke ho
# aur 2-3 mahine paper trading kar chuke ho.
# LIVE_TRADING_ENABLED=true
# LIVE_MAX_CAPITAL=50000

# Zerodha Kite Connect creds (https://kite.trade/)
# KITE_API_KEY="your_api_key"
# KITE_ACCESS_TOKEN="your_access_token"

# Dhan creds (https://dhanhq.co/) — dusra broker, same safety gates
# DHAN_CLIENT_ID="your_client_id"
# DHAN_ACCESS_TOKEN="your_access_token"

# Upstox creds (https://upstox.com/developer/) — teesra broker
# UPSTOX_API_KEY="your_api_key"
# UPSTOX_ACCESS_TOKEN="your_access_token"

# Fyers creds (https://myapi.fyers.in/) — chautha broker
# FYERS_CLIENT_ID="your_client_id"
# FYERS_ACCESS_TOKEN="your_access_token"

# ---------- API ----------
# API_PORT=8000        # docker-compose mein 8000:8000 map hai

# Required operator authentication (minimum 32 characters). Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
# API_AUTH_TOKEN="paste-your-generated-token"
# API_ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
